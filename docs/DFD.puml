@startuml DFD_Context
title DFD — контекстная диаграмма
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #355a75
skinparam UsecaseBackgroundColor #f1f7fc
skinparam UsecaseBorderColor #21384d
skinparam RectangleBackgroundColor white
skinparam RectangleBorderColor #21384d

rectangle "Пользователь API" as user
usecase "0\nОбрабатывать\nучебные данные" as system

user --> system : Учётные данные; запросы; JWT
system --> user : JWT; результаты; ошибки
@enduml


@startuml DFD_Level_1
title DFD — уровень 1: процессы и хранилища
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #355a75
skinparam UsecaseBackgroundColor #f1f7fc
skinparam UsecaseBorderColor #21384d
skinparam RectangleBackgroundColor white
skinparam RectangleBorderColor #21384d

rectangle "Пользователь API" as user
usecase "1.0\nАутентифицировать\nи направлять запросы" as gateway
usecase "2.0\nОбрабатывать учебную\nструктуру и материалы" as academic
usecase "3.0\nОбрабатывать студентов\nи группы" as student
usecase "4.0\nОбрабатывать\nрасписание" as schedule
usecase "5.0\nОбрабатывать\nпосещаемость" as attendance

' Прозрачные прямоугольники используются только как контейнеры текста;
' верхняя и нижняя линии обозначают хранилища в нотации Йордана–Кода.
rectangle "──────────────────────────\nD1 Учётные записи разработки\n──────────────────────────" as d1 #transparent;line:transparent
rectangle "──────────────────────────\nD2 Учебная структура — PostgreSQL\n──────────────────────────" as d2 #transparent;line:transparent
rectangle "──────────────────────────\nD3 Студенты и группы — PostgreSQL\n──────────────────────────" as d3 #transparent;line:transparent
rectangle "──────────────────────────\nD4 Расписание — PostgreSQL\n──────────────────────────" as d4 #transparent;line:transparent
rectangle "──────────────────────────\nD5 Посещаемость — PostgreSQL\n──────────────────────────" as d5 #transparent;line:transparent
rectangle "──────────────────────────\nD6 Материалы и метаданные — MongoDB\n──────────────────────────" as d6 #transparent;line:transparent
rectangle "──────────────────────────\nD7 Поисковый индекс — Elasticsearch\n──────────────────────────" as d7 #transparent;line:transparent
rectangle "──────────────────────────\nD8 Кэш студентов — Redis\n──────────────────────────" as d8 #transparent;line:transparent
rectangle "──────────────────────────\nD9 Граф данных — Neo4j\n──────────────────────────" as d9 #transparent;line:transparent

user --> gateway : Учётные данные; запросы; JWT
gateway --> user : JWT; результаты; ошибки
d1 --> gateway : Логины и хэши паролей

gateway --> academic : Запросы учебных данных
academic --> gateway : Учебные данные; результаты поиска
gateway --> student : Запросы студентов и групп
student --> gateway : Данные студентов и групп
gateway --> schedule : Запросы расписания
schedule --> gateway : Данные расписания
gateway --> attendance : Запросы и отметки посещаемости
attendance --> gateway : Журнал; история; результат записи

academic --> d2 : Изменённая учебная структура
d2 --> academic : Учебная структура
student --> d3 : Изменённые студенты и группы
d3 --> student : Студенты и группы
schedule --> d4 : Изменённое расписание
d4 --> schedule : Расписание
attendance --> d5 : Отметки посещаемости
d5 --> attendance : Сохранённые отметки
academic --> d6 : Тексты и метаданные
d6 --> academic : Тексты и метаданные
academic --> d7 : Поисковые документы
d7 --> academic : Найденные документы
student --> d8 : Карточки студентов; инвалидация
d8 --> student : Кэшированные карточки студентов
academic --> d9 : Учебная структура графа
d9 --> academic : Граф учебной структуры
student --> d9 : Группы и студенты графа
d9 --> student : Связи студентов и групп
schedule --> d9 : Занятия графа
d9 --> schedule : Расписание студента

legend bottom
  Овал — процесс. Прямоугольник — внешняя сущность.
  Две горизонтальные линии — хранилище. Стрелка — поток данных.
  Межсервисные проверки показаны на отдельной диаграмме.
endlegend
@enduml


@startuml DFD_Interservice
title DFD — дополнение к уровню 1: межсервисные проверки
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #355a75
skinparam UsecaseBackgroundColor #f1f7fc
skinparam UsecaseBorderColor #21384d

usecase "2.0\nОбрабатывать учебную\nструктуру и материалы" as academic
usecase "3.0\nОбрабатывать студентов\nи группы" as student
usecase "4.0\nОбрабатывать\nрасписание" as schedule
usecase "5.0\nОбрабатывать\nпосещаемость" as attendance

student --> academic : ID кафедры и специальности
academic --> student : Результат проверки
schedule --> academic : ID лекции и курса
academic --> schedule : Данные лекции и курса
schedule --> student : ID группы
student --> schedule : Данные группы
attendance --> schedule : ID занятия
schedule --> attendance : Занятие и его группа
attendance --> student : ID студента
student --> attendance : Студент и его группа
@enduml
