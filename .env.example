# API Gateway
GATEWAY_PORT=8000
UPSTREAM_TIMEOUT_SECONDS=5
JWT_SECRET=replace-with-at-least-32-random-characters-for-local-development
JWT_ALGORITHM=HS256
JWT_ISSUER=university-gateway
JWT_AUDIENCE=university-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_CLOCK_SKEW_SECONDS=5

# Docker network
SERVICES_NETWORK_NAME=university-services-network
DATABASE_NETWORK_NAME=university-database-network

# PostgreSQL administrator
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local-password
POSTGRES_DB=postgres

# Service database owners
ACADEMIC_DB_NAME=academic_db
ACADEMIC_DB_USER=academic_user
ACADEMIC_DB_PASSWORD=academic-local-password
STUDENT_DB_NAME=student_db
STUDENT_DB_USER=student_user
STUDENT_DB_PASSWORD=student-local-password
SCHEDULE_DB_NAME=schedule_db
SCHEDULE_DB_USER=schedule_user
SCHEDULE_DB_PASSWORD=schedule-local-password
ATTENDANCE_DB_NAME=attendance_db
ATTENDANCE_DB_USER=attendance_user
ATTENDANCE_DB_PASSWORD=attendance-local-password

# PostgreSQL administration UI
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin-local-password
PGADMIN_PORT=5050

# Dataset generator
SEED_STUDENT_COUNT=1000
SEED_UNIVERSITY_COUNT=2
SEED_GROUP_SIZE=30
SEED_WEEK_COUNT=4
SEED_START_DATE=2026-09-07
SEED_CONCURRENCY=12

# Specialized storage and infrastructure
REDIS_PORT=6379
REDIS_PASSWORD=redis-local-password
REDIS_COMMANDER_PORT=8081
STUDENT_CACHE_TTL_SECONDS=86400
MONGODB_PORT=27017
MONGODB_ROOT_USER=mongo
MONGODB_ROOT_PASSWORD=mongo-local-password
MONGODB_ACADEMIC_DB=academic_content
MONGODB_ACADEMIC_USER=academic_service
MONGODB_ACADEMIC_PASSWORD=academic-mongo-local-password
MONGO_EXPRESS_PORT=8082
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=mongo-express-local-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=neo4j-local-password
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_LECTURES_INDEX=lectures
REPORT_TIMEZONE=Europe/Moscow
REPORT_TIMEOUT_SECONDS=60
KIBANA_PORT=5601
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=rabbitmq
RABBITMQ_DEFAULT_PASS=rabbitmq-local-password
